# Keep this repository focused on the Android mobile app and backend.
/ios/
/linux/
/macos/
/windows/
/web/

# Node.js backend dependencies
**/node_modules/

# Local backend secrets and private service credentials
backend/.env
backend/.env - Copy.example
backend/serviceAccountKey.json
backend/*serviceAccount*.json
!backend/serviceAccountKey.example.json
**/*firebase-adminsdk*.json
**/rzp-key.csv

# Local client/API configuration. Use the example files instead.
android/app/google-services.json
lib/firebase_options.dart
lib/google-services.json
lib/utils/google_maps_keys.dart

# Uploaded runtime files. Keep only exercise demo assets in the public repo.
backend/uploads/*
!backend/uploads/exercises/
!backend/uploads/exercises/**

# Locally generated Android packages
*.apk
*.aab

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/build/
/android/app/debug
/android/app/profile
/android/app/release
